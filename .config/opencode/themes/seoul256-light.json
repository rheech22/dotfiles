{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "white": "#E1E1E1",
    "offwhite": "#D9D9D9",
    "stone": "#D1D1D1",
    "silver": "#A8A8A8",
    "muted": "#757575",
    "gray": "#616161",
    "charcoal": "#4A4A4A",
    "pink": "#BF2172",
    "rose": "#E17899",
    "red": "#BF2172",
    "green": "#719872",
    "sage": "#98BC99",
    "gold": "#9A7200",
    "khaki": "#999872",
    "cyan": "#0099BD",
    "sky": "#98BCBD",
    "ice": "#97DDDF",
