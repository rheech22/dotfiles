#!/bin/bash
# SketchyBar — replaces the auto-hidden macOS menubar.
#
# One bar per display, each showing only its own display's state. paneru keeps
# a separate native space per display (macOS "Displays have separate spaces"),
# and virtual workspace rows hang off the space, so the two displays are fully
# independent. A single bar reading `paneru query active` would follow focus
# and report the other display's windows as its own.
#
# Items are therefore created once per display, named `<kind>.<display>.<n>`,
# and scoped with `display=`. The plugins read the display out of $NAME.
#
# Layout: windows of that display's current row on the left, workspace
# indicators dead centre, clock on the right. `center` is anchored to the
# middle of the display rather than packed after the left items, so a growing
# window list never shifts it.
#
# Bar is transparent: the chips carry their own background.
#
# BAR_HEIGHT is deliberately larger than paneru's `menubar_height`. Chips sit
# vertically centred inside the bar, so setting the bar's height equal to where
# windows start (menubar_height + paneru's top padding) splits the leftover
# space evenly above and below a chip. The bar is transparent, so its extra
# height only positions the chips; `menubar_height` reserves the space.

PLUGIN_DIR="$CONFIG_DIR/plugins"

BAR_HEIGHT=40   # = paneru menubar_height (32) + paneru [padding] top (8)
BUILTIN_WORKSPACE_POSITION=e
EXTERNAL_WORKSPACE_POSITION=center

# Select only stable UI preferences by machine. Display ids and the built-in
# panel are discovered below; profiles never hard-code either one.
DOTFILES_PROFILE="${DOTFILES_PROFILE:-home}"
MACHINE_CONFIG="${DOTFILES_MACHINE_CONFIG:-$HOME/.config/dotfiles/machine.env}"
if [ -r "$MACHINE_CONFIG" ]; then
	. "$MACHINE_CONFIG"
fi
case "$DOTFILES_PROFILE" in
	*[!A-Za-z0-9._-]* | '') DOTFILES_PROFILE=home ;;
esac
PROFILE_FILE="$CONFIG_DIR/profiles/$DOTFILES_PROFILE.sh"
if [ -r "$PROFILE_FILE" ]; then
	. "$PROFILE_FILE"
fi

# Constants and the display map live with the plugins: sketchybar spawns those
# itself and passes only CONFIG_DIR, so an `export` here would not reach them.
. "$PLUGIN_DIR/paneru_display.sh"
if ! paneru_refresh_display_map; then
	echo "sketchybar: could not discover the display map" >&2
	exit 1
fi
DISPLAYS="$(paneru_sketchybar_displays)"
BUILTIN_DISPLAY="$(paneru_builtin_sketchybar_display)"

sketchybar --bar \
	height="$BAR_HEIGHT" \
	position=top \
	color=0x00000000 \
	shadow=off \
	padding_left=10 \
	padding_right=10

sketchybar --default \
	y_offset=-1 \
	padding_left=3 \
	padding_right=3 \
	icon.font="DankMono Nerd Font:Regular:14.0" \
	label.font="DankMono Nerd Font:Bold:12.0" \
	icon.color="$FG" \
	label.color="$FG" \
	icon.padding_left=7 \
	icon.padding_right=5 \
	label.padding_left=2 \
	label.padding_right=9

# Declared before any --subscribe below: subscribing to an event that does not
# exist yet fails silently and the item never updates.
sketchybar --add event paneru_change

for d in $DISPLAYS; do
	##### left: windows on that display's current row #####
	# Pre-created so they keep their slot in the bar's ordering; the plugin
	# only fills them in and hides the unused ones. Nothing polls —
	# paneru_listener.sh turns paneru's event stream into `paneru_change`.
	for i in $(seq 0 $((MAX_WINDOWS - 1))); do
		sketchybar --add item "win.$d.$i" left \
			--set "win.$d.$i" \
			display="$d" \
			drawing=off \
			icon.drawing=off \
			label.font="DankMono Nerd Font:Regular:11.0" \
			label.padding_left=9 \
			label.padding_right=9 \
			background.corner_radius=7 \
			background.height=24 \
			background.drawing=on \
			background.color="$SURFACE"
	done

	sketchybar --add item "windows_watch.$d" left \
		--set "windows_watch.$d" \
		display="$d" \
		drawing=off \
		script="$PLUGIN_DIR/paneru_windows.sh" \
		--subscribe "windows_watch.$d" paneru_change front_app_switched

	##### centre: that display's virtual workspaces #####
	# Paneru's command interface cannot target a display directly. The click
	# helper first synchronizes focus with this item's display and only switches
	# after Paneru confirms the target, preventing cross-display commands.
	# Digits are monospaced on purpose: SF Pro gives "1" a narrower advance
	# than "2", so the chips came out different widths and the "1" sat
	# off-centre inside its own.
	#
	# background.color is set here as well as in the plugin: the plugin only
	# runs once an event arrives, and until then an unset colour leaves the
	# chip blank.
	# The built-in panel's physical notch covers true center items. Its anchor is
	# profile-controlled; external displays keep their ordinary center anchor.
	workspace_position="$EXTERNAL_WORKSPACE_POSITION"
	[ -n "$BUILTIN_DISPLAY" ] && [ "$d" = "$BUILTIN_DISPLAY" ] && workspace_position="$BUILTIN_WORKSPACE_POSITION"
	for n in $(seq 1 "$WORKSPACES"); do
		sketchybar --add item "ws.$d.$n" "$workspace_position" \
			--set "ws.$d.$n" \
			display="$d" \
			icon="$n" \
			label.drawing=off \
			icon.font="DankMono Nerd Font:Bold:13.0" \
			icon.color="$DIM" \
			icon.padding_left=11 \
			icon.padding_right=11 \
			background.corner_radius=7 \
			background.height=24 \
			background.drawing=on \
			background.color="$SURFACE" \
			click_script=":"
	done

	##### right: clock #####
	# A single item rather than an icon chip plus a label in a bracket: with
	# no icon there is nothing to pair, and the item draws its own background.
	sketchybar --add item "clock.$d" right \
		--set "clock.$d" \
		display="$d" \
		update_freq=30 \
		icon.drawing=off \
		label.padding_left=10 \
		label.padding_right=10 \
		background.drawing=on \
		background.color="$SURFACE" \
		background.height=24 \
		background.corner_radius=7 \
		background.border_width=1 \
		background.border_color="$ACCENT" \
		script="$PLUGIN_DIR/clock.sh"
done

# One state query updates every workspace button. Per-button subscriptions race
# each other and can briefly disagree about which display currently has focus.
sketchybar --add item workspaces_watch left \
	--set workspaces_watch drawing=off script="$PLUGIN_DIR/paneru_workspace.sh" \
	--subscribe workspaces_watch paneru_change front_app_switched

##### paneru event bridge #####
# Fully detached — inheriting stdout would keep this config script alive, and
# sketchybar lays the bar out only once the script exits. That leaves every
# item parked at -9999 with the bar apparently missing. Keep the exact parent
# PID instead of matching process command lines: a broad pkill can terminate
# unrelated shells that merely mention paneru_listener.sh.
LISTENER_PID_FILE="${TMPDIR:-/tmp}/sketchybar-paneru-listener.pid"
if [ -r "$LISTENER_PID_FILE" ]; then
	old_listener_pid="$(cat "$LISTENER_PID_FILE")"
	case "$old_listener_pid" in
		'' | *[!0-9]*) ;;
		*)
			pkill -TERM -P "$old_listener_pid" 2>/dev/null
			kill "$old_listener_pid" 2>/dev/null
			;;
	esac
fi
nohup "$PLUGIN_DIR/paneru_listener.sh" >/dev/null 2>&1 &
echo "$!" >"$LISTENER_PID_FILE"
disown

sketchybar --update
