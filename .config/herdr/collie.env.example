# Collie bridge configuration.
#
# Copy to the plugin's config directory, which Collie owns and this repository
# does not link:
#
#   herdr plugin config-dir herdr.collie
#   cp .config/herdr/collie.env.example \
#      "$(herdr plugin config-dir herdr.collie)/.env"
#
# Then edit the values below and run `collie restart`.

# Tailscale login allowed to write. Empty means any tailnet device that reaches
# the bridge gets full write access.
COLLIE_TRUSTED_USER=local_email@example.com

# MagicDNS name the bridge is served from.
COLLIE_PUBLIC_HOSTS=local-host.tailnet.ts.net

# Multiplexer backend: herdr, tmux, or zellij.
COLLIE_MUX=herdr

# Web Push signing keys. Do not copy these between machines; generate a pair
# per install with `collie push-keys`, which appends them to this file.
# COLLIE_VAPID_PUBLIC=
# COLLIE_VAPID_PRIVATE=
